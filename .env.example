# Copy this file to .env.local for local dev, and add the same variables in your
# hosting dashboard (Vercel/Netlify → Environment Variables) for the live site.

# Google Apps Script web app URL that saves sublease requests to your Google Sheet.
# See apps-script/Code.gs and the README. Leave blank to save requests only in
# the browser (local testing).
VITE_REQUESTS_ENDPOINT=

# Optional: link to your post-experience feedback survey (Google Form, Typeform…)
VITE_SURVEY_URL=

# Optional: team inbox shown in the footer and confirmation message
VITE_CONTACT_EMAIL=

# Require @calpoly.edu emails on requests (true/false). Default: true
VITE_REQUIRE_CALPOLY_EMAIL=true
